# ── Transmission (your existing instance) ───────────────────────────────────────
TRANSMISSION_HOST=192.168.0.102
TRANSMISSION_PORT=9091
TRANSMISSION_USER=samba
TRANSMISSION_PW=changeme

# Download paths as Transmission sees them on its own filesystem
MOVIEPATH=/HDD0/Shared/Movies
SHOWSPATH=/HDD0/Shared/Series

# ── TMDB ────────────────────────────────────────────────────────────────────────
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Prowlarr ────────────────────────────────────────────────────────────────────
# Leave blank on first boot — get the key from http://host:9696 after Prowlarr starts,
# then add it here and run: docker compose up -d auto-magnet   (or restart the service)
PROWLARR_API_KEY=

# ── Search defaults ─────────────────────────────────────────────────────────────
MIN_SEEDS=10
DEFAULT_QUALITY=1080p

# ── App port ────────────────────────────────────────────────────────────────────
AMAGNET_PORT=62201

# ── Development kill switch ─────────────────────────────────────────────────────
# Set to 1 to start the server with the scheduler OFF. Nothing is searched for or
# pushed to Transmission, and POST /api/scheduler/run returns 503.
# Use this for any throwaway or test instance: a server started against seeded
# auto-mode data will happily grab it into whatever Transmission and download
# paths the settings name, which on a copied .env are the real ones.
AMAGNET_NO_SCHEDULER=0

# ── Linux user/group for Prowlarr container ─────────────────────────────────────
# Run `id` on the host to find your values
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
